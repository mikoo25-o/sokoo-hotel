
# ============================================================
# SokoHotel — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# PowerShell: Copy-Item .env.example .env.local
# Never commit real server-side secrets.

# --- Supabase (Project Settings -> API) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://isxbtbspdymftxyjyuun.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used for the login/join rate limiter and nothing else.
# Never prefix with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ROTATED_SUPABASE_SECRET

# --- App -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRIAL_DAYS=7

# --- M-Pesa Daraja: SokoHotel subscription payments (optional) ----------------
# Online subscription payment stays switched off until ALL of the first five are set.
# Needs a deployed HTTPS URL. Untested against Safaricom until you try it with sandbox credentials.
#MPESA_ENV=sandbox
#MPESA_CONSUMER_KEY=
#MPESA_CONSUMER_SECRET=
#MPESA_SHORTCODE=
#MPESA_PASSKEY=
# A long random string (24+ characters). It becomes part of the callback URL:
#   https://YOUR-DOMAIN/api/billing/callback/<this value>
#MPESA_CALLBACK_SECRET=
# CustomerPayBillOnline (default, paybill) or CustomerBuyGoodsOnline (till)
#MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For tills, the till number. Defaults to the shortcode.
#MPESA_PARTY_B=
